{
  "name": "consent-control",
  "version": "2.1.2",
  "description": "Consent external sources, cookies, analytics,... with user-centered design",
  "main": "dist/bundle.min.js",
  "module": "dist/bundle.es.js",
  "style": "dist/consentcontrol.main.css",
  "files": [
    "dist/",
    "src/",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build:js": "rollup -c",
    "build:css": "node build-css.js",
    "watch:css": "npm-watch",
    "test": "node --test test/*.test.mjs",
    "preversion": "npm test",
    "version": "npm run build:js && npm run build:css && git add .",
    "postversion": "git push && git push --tags && npm publish --access=public"
  },
  "watch": {
    "build:css": {
      "patterns": [
        "src"
      ],
      "extensions": "scss",
      "quiet": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mmoollllee/consent-control.git"
  },
  "keywords": [
    "cookie",
    "consent",
    "privacy",
    "gdpr"
  ],
  "author": "Moritz Graf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmoollllee/consent-control/issues"
  },
  "homepage": "https://github.com/mmoollllee/consent-control#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "jsdom": "^31.0.1",
    "npm-watch": "^0.11.0",
    "prettier": "2.6.2",
    "pretty-quick": "^3.1.3",
    "rollup": "^2.72.1",
    "sass": "1.51.0"
  }
}
